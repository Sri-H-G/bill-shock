# Bill reading needs ONE of these keys. The sample bill and everything else work without either.
# If both are set, Anthropic is used unless BILL_AI_PROVIDER says otherwise.

# https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Force a provider: anthropic | openai
# BILL_AI_PROVIDER=
